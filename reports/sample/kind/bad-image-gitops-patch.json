{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "opsproof-app",
    "namespace": "opsproof-lab"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "OPS_MODE",
                "value": "normal"
              }
            ],
            "image": "opsproof/app:stable",
            "name": "app"
          }
        ]
      }
    }
  }
}
