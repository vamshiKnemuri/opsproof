{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "opsproof-app",
    "namespace": "opsproof-lab"
  },
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "app",
            "resources": {
              "limits": {
                "memory": "128Mi"
              }
            }
          }
        ]
      }
    }
  }
}
